MVS_DEV_VERSION=0.5.6rc1
MVS_OPEN_PLAN_VERSION=1.0.0

# Local PostgreSQL password used by Docker Compose.
DB_PASSWORD=replace-with-a-local-password

# Explicit shared-account mode is supported only for localhost development.
AUTH_DISABLED=false
# Local defaults; use your public hostname and HTTPS origin on a server.
SIM_SERVER_HOST=localhost
SIM_SERVER_URL=https://localhost:5001

# Required when AUTH_DISABLED=false.
OIDC_CLIENT_ID=replace-with-the-client-id
OIDC_CLIENT_SECRET=replace-with-the-client-secret

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-session-secret
